#include <winver.h>

#define VER_MAJOR 1
#define VER_MINOR 19
#define VER_PATCH 2
#define VER_BUILD 0

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HoiV"
            VALUE "FileDescription", "HoiV P0 host"
            VALUE "FileVersion", "1.19.2.0"
            VALUE "InternalName", "p0_host"
            VALUE "OriginalFilename", "p0_host.exe"
            VALUE "ProductName", "HoiV P0 Host"
            VALUE "ProductVersion", "1.19.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
